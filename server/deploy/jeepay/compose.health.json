{
  "services": {
    "redis": {
      "volumes": ["./health/redis.sh:/run/health/redis.sh:ro"],
      "healthcheck": {"test": ["CMD", "sh", "/run/health/redis.sh"], "interval": "30s", "timeout": "10s", "retries": 5, "start_period": "20s"}
    },
    "namesrv": {
      "volumes": ["./health/mq.sh:/run/health/mq.sh:ro"],
      "healthcheck": {"test": ["CMD", "sh", "/run/health/mq.sh", "namesrv"], "interval": "60s", "timeout": "25s", "retries": 5, "start_period": "30s"}
    },
    "mq": {
      "volumes": ["./health/mq.sh:/run/health/mq.sh:ro"],
      "depends_on": {"namesrv": {"condition": "service_healthy"}},
      "healthcheck": {"test": ["CMD", "sh", "/run/health/mq.sh", "broker"], "interval": "60s", "timeout": "25s", "retries": 5, "start_period": "45s"}
    },
    "payment": {
      "volumes": ["./health/payment.sh:/run/health/payment.sh:ro"],
      "depends_on": {"mysql": {"condition": "service_healthy"}, "redis": {"condition": "service_healthy"}, "mq": {"condition": "service_healthy"}},
      "healthcheck": {"test": ["CMD", "sh", "/run/health/payment.sh"], "interval": "30s", "timeout": "15s", "retries": 5, "start_period": "90s"}
    },
    "manager": {"depends_on": {"mysql": {"condition": "service_healthy"}, "redis": {"condition": "service_healthy"}, "mq": {"condition": "service_healthy"}}},
    "merchant": {"depends_on": {"mysql": {"condition": "service_healthy"}, "redis": {"condition": "service_healthy"}, "mq": {"condition": "service_healthy"}}}
  }
}
